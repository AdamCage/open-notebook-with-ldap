# Open Notebook Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# REQUIRED
# =============================================================================

# Encryption key for storing API credentials securely in the database
# Change this to any secret string (minimum 16 characters recommended)
OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-to-a-secret-string

# =============================================================================
# DATABASE (Default values work with docker-compose.yml)
# =============================================================================

SURREAL_URL=ws://surrealdb:8000/rpc
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# =============================================================================
# OPTIONAL: AI Provider API Keys
# =============================================================================
# You can configure these via the UI (Settings → API Keys) or set them here
# UI configuration is recommended for better security and flexibility

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI
# GOOGLE_API_KEY=...

# Groq
# GROQ_API_KEY=gsk_...

# =============================================================================
# OPTIONAL: Authentication Mode
# =============================================================================
# Controls how users authenticate. Possible values:
#   none     -- No authentication (default). Open access, single-user.
#   password -- Shared password via OPEN_NOTEBOOK_PASSWORD. No user isolation.
#   local    -- Per-user accounts with registration and admin approval. RBAC enabled.
#   ldap     -- LDAP/Active Directory login with auto-registration. RBAC enabled.
#
# WARNING: In none/password modes ALL role-based access controls are disabled.
# Every user has full admin-level access. Use local or ldap for real multi-user security.

# AUTH_MODE=none

# --- Local mode settings ---
# Required when AUTH_MODE=local. The super-admin account is auto-created on
# first startup if it doesn't exist.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=changeme

# --- LDAP mode settings ---
# Required when AUTH_MODE=ldap. Set ADMIN_USERNAME to the LDAP user who should
# become super-admin (auto-promoted on first LDAP login).
# ADMIN_USERNAME=admin

# --- JWT Secret ---
# Dedicated secret for signing JWT session tokens (used in local and ldap modes).
# Priority: JWT_SECRET > LDAP_JWT_SECRET > OPEN_NOTEBOOK_ENCRYPTION_KEY.
# For production, always set a unique value different from the encryption key.
# JWT_SECRET=

# =============================================================================
# OPTIONAL: LDAP Server Configuration (required when AUTH_MODE=ldap)
# =============================================================================

# ENABLE_LDAP=true
# LDAP_SERVER_HOST=ldap.example.com
# LDAP_SERVER_PORT=389
# LDAP_USE_TLS=true
# LDAP_VALIDATE_CERT=true
# LDAP_CA_CERT_FILE=
# LDAP_CIPHERS=ALL
# LDAP_ATTRIBUTE_FOR_USERNAME=uid
# LDAP_ATTRIBUTE_FOR_MAIL=mail
# LDAP_APP_DN=cn=admin,dc=example,dc=com
# LDAP_APP_PASSWORD=admin_password
# LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
# LDAP_SEARCH_FILTERS=
# LDAP_JWT_SECRET=                           # Falls back to JWT_SECRET or OPEN_NOTEBOOK_ENCRYPTION_KEY

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

# External API URL (for webhooks, callbacks, etc.)
# API_URL=http://localhost:5055

# Ollama endpoint (if running locally)
# OLLAMA_BASE_URL=http://ollama:11434

# Content processing
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=150

# Shared password (only used when AUTH_MODE=password; ignored in local/ldap modes)
# OPEN_NOTEBOOK_PASSWORD=secret

# For more configuration options, see:
# https://github.com/lfnovo/open-notebook/blob/main/docs/5-CONFIGURATION/environment-reference.md
