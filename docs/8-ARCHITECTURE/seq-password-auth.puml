@startuml seq_password_auth
title Password Authentication Flow

actor User
participant "LoginForm" as LF
participant "auth-store\n(Zustand)" as Store
participant "API Server\n(FastAPI)" as API
participant "PasswordAuth\nMiddleware" as MW

User -> LF : Enter password, click Sign In
LF -> Store : login(password)
Store -> API : GET /api/notebooks\nAuthorization: Bearer {password}
API -> MW : dispatch(request)

alt Password matches OPEN_NOTEBOOK_PASSWORD
    MW -> MW : Set request.state.user\n= {sub: "__password__", type: "password"}
    MW -> API : call_next(request)
    API --> Store : 200 OK (notebooks list)
    Store -> Store : isAuthenticated = true\ntoken = password
    Store --> LF : success = true
    LF -> User : Redirect to /notebooks
else Password does not match
    MW --> API : 401 Unauthorized
    API --> Store : 401
    Store -> Store : error = "Invalid password"
    Store --> LF : success = false
    LF -> User : Show error message
end

@enduml
